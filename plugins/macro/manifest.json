{
  "view": {
    "syntax_color": "#3d59a1",
    "hint": "RUN \"backup_routine\" ;",
    "description": "Executes a pre-defined sequence of commands saved in the Macros gallery."
  },
  "plugin_id": "macro_mod",
  "version": "1.3.0",
  "triggers": [
    {
      "group_name": "Macro Execution",
      "keywords": [
        "RUN",
        "Run",
        "run"
      ]
    }
  ],
  "behavior": {
    "action_name": "macro",
    "supports_simulation": true,
    "requires_dst": false,
    "auto_relpath": false,
    "allowed_protocols": [
      "SINGLE"
    ],
    "parser_method": "parse_unary",
    "max_recursion_depth": 15
  },
  "reporting": {
    "exec_status": "EXECUTED",
    "sim_status": "WILL EXECUTE"
  }
}