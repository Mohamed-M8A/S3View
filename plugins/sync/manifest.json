{
  "view": {
    "syntax_color": "#1abc9c",
    "hint": "SYNC (depth: 2) \"s3://source-bucket/\" to \"local://backup-folder/\" ;",
    "description": "Smart synchronization engine that transfers only new or modified files by comparing sizes and timestamps. Use SYNCPURGE to also delete files from the destination that no longer exist in the source."
  },
  "plugin_id": "sync_mod",
  "version": "1.4.0",
  "triggers": [
    {
      "group_name": "Standard Sync",
      "keywords": [
        "SYNC",
        "Sync",
        "sync"
      ],
      "behavior_flags": {
        "purge": false
      }
    },
    {
      "group_name": "Purge Sync",
      "keywords": [
        "SYNCPURGE",
        "SyncPurge",
        "syncpurge",
        "SYNCP",
        "syncp"
      ],
      "behavior_flags": {
        "purge": true
      }
    }
  ],
  "behavior": {
    "action_name": "sync",
    "supports_simulation": true,
    "requires_dst": true,
    "auto_relpath": true,
    "allowed_protocols": [
      "S2S",
      "S2L",
      "L2S",
      "L2L"
    ],
    "parser_method": "parse_binary",
    "dst_is_container": true
  },
  "reporting": {
    "exec_status": "SYNCED",
    "sim_status": "WILL SYNC"
  }
}