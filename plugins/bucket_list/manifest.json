{
  "plugin_id": "bucket_list_mod",
  "version": "1.0.0",
  "view": {
    "syntax_color": "#50fa7b",
    "hint": "LB;",
    "description": "Lists every S3 bucket accessible to the current credentials."
  },
  "triggers": [
    {
      "group_name": "Discovery",
      "keywords": [
        "LB", "Lb", "lb",
        "LIST_BUCKETS", "List_Buckets", "list_buckets",
        "DISCOVER", "Discover", "discover"
      ],
      "behavior_flags": {}
    }
  ],
  "behavior": {
    "action_name": "bucket_list",
    "supports_simulation": true,
    "requires_dst": false,
    "auto_relpath": false,
    "allowed_protocols": ["SINGLE"],
    "parser_method": "parse_nullary",
    "requires_s3": true
  },
  "reporting": {
    "exec_status": "FOUND",
    "sim_status": "FOUND"
  }
}
